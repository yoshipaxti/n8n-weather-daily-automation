    {
      "parameters": {
        "jsCode": "// Grab data and set fallback\nconst data = $input.first().json;\nconst city = data.name || \"Your City\";\n\n// Round temps and convert main to string for Canva\nconst temp = Math.round(data.main.temp).toString();\nconst low = Math.round(data.main.temp_min);\nconst high = Math.round(data.main.temp_max);\n\n// Handle weather state & icons\nconst cities = data.weather[0].main;\nconst icons = {\n  Clear: \"☀️\",\n  \"Mainly Clear\": \"🌤️\",\n  \"Partly Cloudy\": \"⛅\",\n  Clouds: \"☁️\",\n  Fog: \"🌫️\",\n  Drizzle: \"🌦️\",\n  Rain: \"🌧️\",\n  Thunderstorm: \"⛈️\",\n  Snow: \"❄️\"\n};\n\nconst emoji = icons[cities];\n\n// Get local date (YYYY-MM-DD)\nconst today = new Date().toLocaleDateString('en-CA'); \n\nreturn [{\n  json: {\n    city,\n    date: today,\n    temp,\n    condition: cities,\n    emoji,\n    caption: `Good morning! ${city} weather today: ${cities}, ${temp}°C.`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
